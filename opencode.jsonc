{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kicad": {
      "type": "local",
      "command": [
        "uvx",
        "kicad-mcp-pro"
      ],
      "enabled": true,
      "environment": {
        "KICAD_MCP_PROJECT_DIR": "/home/sapy/sportwatch_ai/sportwatch_revA",
        "KICAD_MCP_PROFILE": "review",
        "KICAD_MCP_OPERATING_MODE": "readonly"
      },
      "timeout": 120000
    }
  }
}

