    {
      "op": "add_text_box",
      "key": "heading",
      "text": "ZC-A1D43W-046  |  466 x 466 AMOLED + touch\nJ1 = motherboard socket. Display/touch/power ICs are inside the module.\nPhysical buttons remain the primary sports controls; touch is an additional UI input.",
      "at": [
        700,
        500
      ],
      "size": [
        10000,
        450
      ]
    },
    {
      "op": "add_text_box",
      "key": "pins16",
      "text": "Pin 16 documentation discrepancy: mechanical drawing P5 labels VDD; interface table P9 labels TP_VDD. Both require 3.3 V in this design. P9 naming used pending supplier clarification.",
      "at": [
        3800,
        1250
      ],
      "size": [
        6400,
        400
      ]
    },
    {
      "op": "add_text_box",
      "key": "bias",
      "text": "HOST DEFAULT STATES\nR303/R304 hold active-low resets asserted.\nR305 deselects QSPI during host startup.\n10k: 0.33mA at 3.3V; verify internal module\nbias/leakage and GPIO drive during bring-up.\nR306 DNP: VCI_EN polarity/internal bias\nnot specified in supplied module PDF.",
      "at": [
        700,
        4700
      ],
      "size": [
        3100,
        950
      ]
    },
    {
      "op": "add_text_box",
      "key": "pullups",
      "text": "TOUCH I2C — R301 / R302 DNP\n3.6k provisions to SYS_3V3; fit only if needed.\nProvisional target: 100kHz, total Cbus <=100pF.\nNXP UM10204 calculation: 0.967k < Rp < 11.8k.\nCHSC datasheets specify no resistor value.\nConfirm module pull-ups, sink capability and\nfinal bus capacitance before population.\nDo not use 1.8V PMIC bus pull-ups.",
      "at": [
        7500,
        3200
      ],
      "size": [
        3100,
        1050
      ]
    },
    {
      "op": "add_text_box",
      "key": "power",
      "text": "POWER / PCB\nJ1.11/12 -> VSYS (module VBAT: 2.9-5.5V).\nJ1.15/16 -> SYS_3V3 (3.15-3.45V).\nJ1.2/8/13/14/21 -> GND; 9/10 explicitly NC.\nInternal IC passives are not duplicated.\nRoute both VBAT pins and every GND pin.\n02_POWER rails are local labels: export them\nin the later integration pass to power this sheet.\nNo PWR_FLAG hides the missing source.",
      "at": [
        4000,
        4450
      ],
      "size": [
        3300,
        1200
      ]
    },
    {
      "op": "add_text_box",
      "key": "seq",
      "text": "FIRMWARE / INTEGRATION — Apollo balls unallocated; all interfaces are 3.3V\nCO5300 pp100/101/116: hold DISP_RST low at startup; VDDI must precede internal VCI.\nWait >=10ms after rails valid before releasing reset; >=10ms before first command;\nwait >=120ms after reset before Sleep Out, then >=60ms before Display On.\nShutdown: Display Off -> Sleep In -> wait >=83ms -> reset low -> internal VCI off before VDDI.\nVCI_EN controls internal power: obtain module enable polarity/delays and initialization code.\nCHSC6417 section 8: TOUCH_RST low >=100us before power; hold >=1ms after power valid;\nreset pulse >=500us; allow up to 200ms for ready INT. Power cycle: <0.3V for >=2ms.\nTP_VDD rise (10-90%) <=5ms; assert TOUCH_RST before power-down.\nKeep shared I2C idle during touch reset; never drive it while TP_VDD is off.\nModule timing and internal bias must be confirmed on hardware before production release.",
      "at": [
        700,
        5900
      ],
      "size": [
        6100,
        1400
      ]
    },
    {
      "op": "add_text_box",
      "key": "connector",
      "text": "CONNECTOR / ASSEMBLY\nOK-23GF024-04 socket mates with module's OK-23GM024-04 male (module P5, OCN P1/P3).\nFootprint F.Cu view: lower row 1..12 left-to-right; upper row 24..13 left-to-right.\nPin 1 is marked at lower left. Mating-face views reflect across the connector long axis.\nMatch to P5 FPC pin-1 corner; check folded FPC orientation before board placement.",
      "at": [
        7500,
        4550
      ],
      "size": [
        3100,
        1100
      ]
    }
  ]
}
