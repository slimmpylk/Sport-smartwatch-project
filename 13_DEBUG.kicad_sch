	(text "J1301 target pinout: 1=VTREF, 2=SWDIO, 3=nRESET, 4=SWCLK, 5=GND, 6=SWO. This matches the common TC2030 Cortex SWD mapping."
		(exclude_from_sim no)
		(at 20 148 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "261bd285-58e3-448c-8081-459a7d73b238")
	)
	(text "13_DEBUG — APOLLO510B SWD / SWO / RESET + REV-A POWER TEST PADS"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "39bc5cc2-1ab7-4673-8898-bcef13737821")
	)
	(text "SWO is optional for normal programming/debug. Apollo errata note SWO behavior in deep sleep and debugger reconnect corner cases; do not depend on SWO for production operation."
		(exclude_from_sim no)
		(at 20 179.2 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "4b70d5bd-1aea-4d96-8626-64d5aa3ea31d")
	)
	(text "VTREF is VOUT1_1V8 because GPIO20/21 belong to the VDDH I/O bank. The debugger should use this as target-voltage sense/reference, not as a board power source."
		(exclude_from_sim no)
		(at 20 168.8 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "4e3d6a2b-fd09-4964-95a4-de02f1778b8b")
	)
	(text "All labels are still child-sheet-local. Final root integration must export VOUT1_1V8 / rails and connect APOLLO_SWDIO, APOLLO_SWCLK, APOLLO_RST_N, APOLLO_SWO_GPIO28 to 01_APOLLO510B."
		(exclude_from_sim no)
		(at 20 194.8 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "5331d3c3-2b1e-447d-80d6-03fb9382b507")
	)
	(text "Apollo510B SWCLK is GPIO20 / ball M3 / function 0 SWDCK. SWDIO is GPIO21 / ball N3 / function 0 SWDIO. Reserve both from normal peripheral allocation."
		(exclude_from_sim no)
		(at 20 153.2 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "7f1bb20e-cd8c-466c-b415-6d11a2460520")
	)
	(text "TC2030 no-legs footprint and 1.0-mm test-pad footprints are intentionally subject to the dedicated pre-PCB footprint/mechanical audit."
		(exclude_from_sim no)
		(at 20 189.6 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "8424e7b0-3b36-4061-a7b9-f47c22f9bd8e")
	)
	(text "External reset is dedicated ball H4 RSTN. Apollo includes an internal pull-up and reset debounce; no external pull-up or reset capacitor is added here."
		(exclude_from_sim no)
		(at 20 158.4 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "99b41473-c3fe-42fd-868e-d95e1f553f0b")
	)
	(text "SWO is deliberately GPIO28 / ball L1 / function 0. The Ambiq Secure Bootloader already uses GPIO28 as a 1-Mbaud SWO boot-status output."
		(exclude_from_sim no)
		(at 20 163.6 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "d9565951-03b4-4830-82f2-961e96133838")
	)
	(text "Apollo510B SWD supports up to 20 MHz, but the datasheet notes SWD read timing can require reduced SWCLK. Start bring-up around 4-10 MHz."
		(exclude_from_sim no)
		(at 20 174 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "dcaa7367-3f54-4d03-9c51-dd4b4316618d")
	)
	(text "Primary debug connector is a 6-pin TC2030 Cortex-SWD style target. No permanent header is required on the watch PCB."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left bottom)
		)
		(uuid "eb6581f9-ec4a-4dfa-9fc8-abaab3b74020")
	)
	(text "TP1301-TP1306 are Rev-A bring-up pads only. They provide quick access to battery/system rails before the enclosure is closed."
		(exclude_from_sim no)
		(at 20 184.4 0)
		(effects
			(font
				(size 0.75 0.75)
			)
			(justify left bottom)
		)
		(uuid "f5b7a910-00dd-4e3c-9c83-a219994a5bb2")
	)
