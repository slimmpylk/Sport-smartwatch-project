	(text "APPLE-INSPIRED 12-EMITTER PPG: 4x green, 4x red, 3x IR850, 1x IR940. Current Apple Ultra 4 exact emitter count is not publicly enumerated; this follows the documented Ultra/Ultra 2 wavelength mix within dual-MAX86141 12-LED capability."
		(exclude_from_sim no)
		(at 305 220 0)
		(effects (font (size 0.65 0.65)) (justify left bottom))
		(uuid "5fc34849-63d5-40ed-9dbd-1dc8b1274862")
	)
	(text "TS5A12301E mux logic: GPIO2 HIGH -> NO = LED1/2/3; GPIO2 LOW -> NC = LED4/5/6. Power muxes from PPG_VLED; 1.8V GPIO control is supported."
		(exclude_from_sim no)
		(at 305 224 0)
		(effects (font (size 0.65 0.65)) (justify left bottom))
		(uuid "261d76ad-9396-407a-9ae3-ad64ec6bfa6a")
	)
	(text "Firmware starting current caps: SFH4053B IR850 <=62mA; SFH7018A red <=31mA baseline; green/IR940 <=62mA baseline until optical/thermal/eye-safety validation."
		(exclude_from_sim no)
		(at 305 228 0)
		(effects (font (size 0.65 0.65)) (justify left bottom))
		(uuid "48f44e5b-cedc-4889-ba39-2472f79be1c1")
	)
