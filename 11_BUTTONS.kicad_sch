			)
			(justify left bottom)
		)
		(uuid "ac0b8e85-be9e-4ebc-afaf-948b0336db22")
	)
	(text "No exposed electrical button contacts are assumed. If the final mechanical design creates an external conductive ESD path, add local ESD protection after mechanical review."
		(exclude_from_sim no)
		(at 150 91 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b57a8032-1caa-4e6f-9f0f-dfa56d147f05")
	)
	(text "Final Apollo510B assignment: choose GPIOs valid in the selected low-power mode and configure falling-edge wake/interrupt."
		(exclude_from_sim no)
