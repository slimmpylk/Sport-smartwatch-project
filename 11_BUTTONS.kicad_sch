	(text "Switch footprints intentionally TBD until the exact sealed side-actuated tact switch / mechanical plunger stack is selected."
		(exclude_from_sim no)
		(at 25 32 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1dffbdc4-67c1-4ac1-b96e-0dfb3a3ef143")
	)
	(text "Each input has a 100k external pull-up to VOUT1_1V8 and 47nF hardware filter. Firmware should still debounce."
		(exclude_from_sim no)
		(at 25 22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "22565abd-5a28-4c8f-a333-8519c1a21ead")
	)
	(text "Apollo510B GPIO input leakage is max 20nA, so 100k pull-ups retain very large DC noise margin."
		(exclude_from_sim no)
		(at 150 79 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2f2b3123-8afa-43bf-907e-12d6f025bf79")
	)
	(text "Do not rely on button labels as final GPIO ball assignments; those are frozen only during the Apollo integration pass."
		(exclude_from_sim no)
		(at 150 85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4295742a-2fbf-4bb6-b189-bbbe0e37c3f7")
	)
	(text "100k + 47nF gives tau ~= 4.7ms (release threshold ~5.7ms for a 0.7*VDD GPIO VIH)."
		(exclude_from_sim no)
		(at 150 73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "657ad281-b290-42b4-9811-e925ff5640d1")
	)
	(text "11_BUTTONS — FIVE PHYSICAL WATCH BUTTONS — ACTIVE LOW"
