	(text "RFU/VSF/NC balls remain unconnected exactly as Kingston requires. Footprint is intentionally still unassigned pending the dedicated FBGA153 footprint audit."
		(exclude_from_sim no)
		(at 150 181 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "014afde7-15cf-4047-bc54-bcfe37a999b5")
	)
	(text "Kingston states DAT1-DAT7 internal pull-ups are disconnected after entering wide-bus modes, so external biasing remains useful."
		(exclude_from_sim no)
		(at 150 151 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "07ce37cd-8069-48b7-9823-6d0743c9b9d4")
	)
	(text "Kingston's public datasheet calls for an external VDDI Creg but refers exact design values to a separate design guide; capacitor values use standard eMMC guidance."
		(exclude_from_sim no)
		(at 150 163 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "18674796-3094-4786-bcbf-90bddb19bcf2")
	)
	(text "09_STORAGE — 64 GB eMMC / APOLLO510B SDIO0 8-BIT — REV A"
		(exclude_from_sim no)
		(at 18 13 0)
		(effects
			(font
				(size 1.55 1.55)
			)
			(justify left bottom)
		)
		(uuid "1c33e219-4683-4f38-8725-3d253272886a")
	)
	(text "Architecture: Apollo510B SDIO0 is reserved for this eMMC because SDIO0 supports the full 8-bit eMMC bus."
		(exclude_from_sim no)
		(at 18 145 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "54b78ef6-603f-4719-8355-157f1a3b446e")
	)
	(text "EMMC_RST_N uses a normal Apollo GPIO; hardware reset is disabled by default in eMMC and must be enabled through EXT_CSD if used."
		(exclude_from_sim no)
		(at 18 163 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "62c28552-ebf6-4eab-bde2-bc66961766db")
	)
	(text "Add/tune a small CLK source-series resistor near Apollo during 01_APOLLO integration (22 ohm initial target); keep it physically at the host, not beside U1."
		(exclude_from_sim no)
		(at 150 175 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "78c76f8d-49ef-48e0-85f6-7f4aadfa365c")
	)
	(text "Apollo510B documents SDIO0 up to 96 MHz / 96 MB/s. Therefore U1 is NOT operated in HS400; H5/DS is intentionally NC."
		(exclude_from_sim no)
		(at 18 151 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "8320bbf3-df69-4268-9967-89009a742cb4")
	)
	(text "Place U1 close to Apollo. Route CLK/CMD/DAT0..7 as controlled-impedance short traces with a continuous reference plane; length/skew review occurs in PCB phase."
		(exclude_from_sim no)
		(at 150 169 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "83a5bef7-7027-4663-b8af-adeb6319f758")
	)
	(text "U1 custom FBGA153 ball map verified against Kingston Table 9 before wiring."
		(exclude_from_sim no)
		(at 18 19 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left bottom)
		)
		(uuid "885d3b9e-6e9a-46d4-88ef-68dec1d37f25")
	)
	(text "VCC = VOUT2_3V0_PROVISIONAL. Kingston allows 2.7-3.6 V; 3.0 V reduces load on the separate display 3.3 V rail."
		(exclude_from_sim no)
		(at 18 169 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "90f71d41-d0c2-424f-9380-e0ad49912bab")
	)
	(text "C901/C902: VCC 4.7uF + 220nF. C903/C904: VCCQ 2.2uF + 100nF. C905/C906: VDDI 1uF + 100nF."
		(exclude_from_sim no)
		(at 150 157 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "97ce3db9-745e-4c5d-9c02-0c226959b30a")
	)
	(text "Reserve Apollo SDIF0 signals: DAT0..3 on GPIO84..87, CLK on GPIO88, DAT4..7 on GPIO156..159, CMD on GPIO160."
		(exclude_from_sim no)
		(at 18 157 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "a5b760e2-9234-4529-9b86-5b418a890aa6")
	)
	(text "VCCQ = VOUT1_1V8. This keeps the complete SDIO0 bus in the 1.8 V I/O domain and preserves high-speed compatibility."
		(exclude_from_sim no)
		(at 18 175 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "c002272c-911e-40bf-8e6a-f5b8c7086336")
	)
	(text "R901=10k CMD pull-up; R902-R909=47k DAT pull-ups; R910=47k reset pull-up. Values are conservative eMMC/JEDEC-style biasing."
		(exclude_from_sim no)
		(at 150 145 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
		(uuid "e043b98d-df47-4a87-9355-926c18e8ff05")
	)
	(text "VOUT rails and host labels are still local to this child sheet until final hierarchical integration."
		(exclude_from_sim no)
		(at 150 187 0)
		(effects
			(font
				(size 0.82 0.82)
			)
			(justify left bottom)
		)
